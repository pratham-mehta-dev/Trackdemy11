rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'unassigned';
    }

    // User profile and subcollections
    match /users/{userId} {
      // Users can read/write their own data
      // Faculty/Admin can read all user profiles for management
      allow read: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
      allow write: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
      
      // Explicitly allow listing users for Faculty/Admin
      allow list: if isSignedIn() && getUserRole() in ['faculty', 'admin'];

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
      }
      
      match /badges/{badgeId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
        allow write: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
      }

      match /examResults/{courseId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
        allow write: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
      }

      match /payments/{paymentId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || getUserRole() in ['faculty', 'admin']);
        allow write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    
    // Courses and their content
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isSignedIn() && getUserRole() in ['faculty', 'admin'];
      
      match /content/{contentId} {
        allow read: if true;
        allow write: if isSignedIn() && getUserRole() in ['faculty', 'admin'];
      }
    }
    
    // Exams
    match /exams/{examId} {
      allow read: if true;
      allow write: if isSignedIn() && getUserRole() in ['faculty', 'admin'];
    }

    // Settings (Public read for Maintenance Mode/Platform Name)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn() && getUserRole() in ['faculty', 'admin'];
    }
    
    // Global fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
